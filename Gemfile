source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# github-pages already bundles jekyll-feed, jekyll-sitemap and jekyll-seo-tag,
# they just need to be listed under `plugins:` in _config.yml (done).

# Windows/JRuby users may need these; harmless elsewhere.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
